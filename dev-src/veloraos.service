[Unit]
Description=VeloraOS private application backend
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/veloraos
Environment=PYTHONUNBUFFERED=1
Environment=VELORAOS_ROOT=/opt/veloraos
Environment=HOME=/opt/veloraos
Environment=VELORAOS_LICENSE_API_BASE=https://www.veloraos.co.uk
Environment=VELORAOS_WEB_ENABLED=1
Environment=VELORAOS_WEB_API_BASE=https://web-api.veloraos.co.uk
Environment=VELORAOS_WEB_TIMEOUT=5
Environment=VELORAOS_WEB_FETCH_TIMEOUT=4
Environment=VELORAOS_OLLAMA_KEEP_ALIVE=30m
Environment=VELORAOS_OLLAMA_CHAT_TIMEOUT=90
Environment=VELORAOS_OLLAMA_RETRY_TIMEOUT=45
Environment=VELORAOS_LICENSE_TIMEOUT=10
Environment=VELORAOS_LICENSE_OFFLINE_GRACE_SECONDS=259200
Environment=VELORAOS_LICENSE_RECHECK_SECONDS=21600
Environment=VELORAOS_UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/velora-opersys/veloraos-sh/main/installer/update/latest.json
Environment=VELORAOS_UPDATE_CHECK_SECONDS=7200
Environment=VELORAOS_UPDATE_TIMEOUT=12
Environment=VELORAOS_UPDATE_STATE_FILE=/var/lib/veloraos/update-state.json
Environment=VELORAOS_UPDATE_LOG_FILE=/var/lib/veloraos/update.log
Environment=VELORAOS_UPDATE_PENDING_DIR=/var/lib/veloraos/update/pending
Environment=VELORAOS_STATE_DIR=/var/lib/veloraos
RuntimeDirectory=veloraos
RuntimeDirectoryMode=0755
ExecStartPre=/usr/bin/test -x /opt/veloraos/.venv/bin/python
ExecStartPre=/opt/veloraos/.venv/bin/python -m py_compile /opt/veloraos/app/main.py
ExecStart=/opt/veloraos/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8100 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
